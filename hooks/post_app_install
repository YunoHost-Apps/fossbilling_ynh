#!/bin/bash

source /usr/share/yunohost/helpers

app=$YNH_APP_INSTANCE_NAME
install_dir=$(ynh_app_setting_get --app=$app --key=install_dir)
#ynh_config_add --template="config.php" --destination="$install_dir/config.php"
#ynh_replace --match="'maintenance_mode' => [ 'enabled' => true" --replace="'maintenance_mode' => [ 'enabled' => false" --file="$install_dir/config.php"
ynh_write_var_in_file --file="$install_dir/config.php" --key="enabled" --value=false --after="'maintenance_mode'"
ynh_store_file_checksum "$install_dir/config.php"